{
  "name": "mirrorbird-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/ui.mjs && node tests/sync-ui.mjs && node tests/history-ui.mjs",
    "build": "npm run typecheck && vite build"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "playwright": "1.64.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=24"
  }
}
